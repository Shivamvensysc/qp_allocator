{
  "$schema": "https://turbo.build/schema.json",

  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },

    "dev": {
      "cache": false
    },

    "lint": {
      "outputs": []
    },

    "type-check": {
      "dependsOn": ["^type-check"]
    }
  }
}